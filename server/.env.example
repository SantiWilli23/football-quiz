PORT=4000
JWT_SECRET=change-this-to-a-long-random-secret

# Local SQLite file (default, used in development)
DATABASE_URL=file:./data/football.db

# For production with Turso (https://turso.tech), set instead:
# DATABASE_URL=libsql://your-db-name.turso.io
# DATABASE_AUTH_TOKEN=your-turso-token

# Recordatorio diario por notificación push (todo opcional).
# Si no definís las claves VAPID, el servidor genera un par la primera vez y lo
# guarda en la base: las notificaciones funcionan sin configurar nada.
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# PUSH_CONTACT=mailto:vos@ejemplo.com

# Hora (0-23) a partir de la cual sale el recordatorio. Por defecto 19.
# REMINDER_HOUR=19

# Secreto para que un cron externo pueda disparar POST /api/push/send-daily.
# Sin esto, el aviso depende del temporizador interno (ver README).
# PUSH_CRON_SECRET=

# Datos de fútbol en vivo (resultados, tabla, goleadores, alineaciones).
# La key se saca gratis en https://dashboard.api-football.com — el plan free
# da 100 pedidos por día, que alcanza para un grupo chico gracias al caché.
# Sin esta variable la sección de fútbol avisa que falta configurarla, y el
# resto de la app anda igual.
# FOOTBALL_API_KEY=

# Segundos que se guarda cada tipo de dato antes de volver a pedirlo.
# Subilos si te estás quedando corto de pedidos diarios.
# FOOTBALL_TTL_LIVE=180
